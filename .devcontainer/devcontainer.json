{
    "name": "Renode Example",
    "dockerFile": "../Dockerfile",
    "runArgs": [
        "--security-opt",
        "label=disable"
    ],
    "containerEnv": {
        "WORKSPACE_DIR": "${containerWorkspaceFolder}",
        "PROMPT_COMMAND": "history -a",
        "EDITOR": "code --wait"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "remoteUser": "root",
}
